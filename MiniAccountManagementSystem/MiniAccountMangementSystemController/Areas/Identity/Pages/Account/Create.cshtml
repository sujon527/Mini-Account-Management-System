@page
@model MiniAccountMangementSystemController.Areas.Identity.Pages.Account.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create New Account";
}



<h1>Create New Account</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Account.AccountName"></label>
        <input asp-for="Account.AccountName" class="form-control" />
        <span asp-validation-for="Account.AccountName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Account.ParentAccountId">Parent Account (optional)</label>
        <select asp-for="Account.ParentAccountId" class="form-control" asp-items="Model.ParentAccountOptions">
            <option value="">-- None --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
