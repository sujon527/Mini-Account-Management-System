@page "{id:int}"
@model MiniAccountMangementSystemController.Areas.Identity.Pages.Account.DeleteModel
@{
    ViewData["Title"] = "Delete Account";
}

<h2>Delete Account</h2>

<h3>Are you sure you want to delete this account?</h3>

<div>
    <h4>@Model.Account.AccountName</h4>
    <p>Parent Account ID: @Model.Account.ParentAccountId</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Account.AccountId" />
    <button type="submit">Delete</button>
    <a asp-page="Index">Cancel</a>
</form>

